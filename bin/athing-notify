#!/usr/bin/env bash
# Hook callback client. The agent CLI execs this on each lifecycle event with the
# payload on stdin. It forwards the payload to the loopback hook receiver and never
# blocks or fails the agent.
set -u

if [ -n "${ATHING_GATE_URL:-}" ]; then
  # Gate mode: POST to the gate hook endpoint with bearer auth.
  curl -sS --max-time 5 \
    -H "content-type: application/json" \
    -H "Authorization: Bearer ${ATHING_SESSION_TOKEN:-}" \
    -H "x-session-id: ${ATHING_SESSION_ID:-}" \
    --data-binary @- \
    "${ATHING_GATE_URL}/hook/${ATHING_SESSION_ID:-}" >/dev/null 2>&1 || true
  exit 0
fi

[ -z "${ATHING_BRIDGE_URL:-}" ] && exit 0

hdr=(
  -H "content-type: application/json"
  -H "x-session-token: ${ATHING_SESSION_TOKEN:-}"
  -H "x-session-id: ${ATHING_SESSION_ID:-}"
)

case "$ATHING_BRIDGE_URL" in
  /*) curl -sS --max-time 5 --unix-socket "$ATHING_BRIDGE_URL" "${hdr[@]}" \
        --data-binary @- "http://localhost" >/dev/null 2>&1 || true ;;
  *)  curl -sS --max-time 5 "$ATHING_BRIDGE_URL" "${hdr[@]}" \
        --data-binary @- >/dev/null 2>&1 || true ;;
esac

exit 0
