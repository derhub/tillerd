{
  "name": "tillerd",
  "private": true,
  "description": "Experimental toolkit for driving coding agents.",
  "license": "MIT",
  "author": "derhub <imjohnderbaul@gmail.com>",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "turbo run build",
    "build:ci": "turbo run build --filter=!tillerd-desktop",
    "build:services": "bash tools/build-services.sh",
    "predev": "bash tools/build-services.sh",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test --filter='!./tests/*'",
    "eval": "turbo run eval",
    "e2e": "turbo run e2e",
    "lint": "oxlint . && turbo run lint",
    "format": "oxfmt --write . && turbo run fmt",
    "format:check": "oxfmt --check . && cargo fmt --check",
    "cargo:test": "cargo test --workspace",
    "cargo:lint": "cargo clippy --all-targets --locked -- -D warnings",
    "cargo:fmt": "cargo fmt",
    "cargo:fmt:check": "cargo fmt --check",
    "verify": "bun run format:check && bun run check-types && bun run lint && bun run test && turbo run e2e",
    "check-deps": "turbo run check-deps",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "turbo": "^2.9.16",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14"
}
