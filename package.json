{
  "name": "a-thing",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "ATHING_DIR=$(pwd)/.athing turbo run build",
    "dev": "ATHING_DIR=$(pwd)/.athing ATHING_DAEMON_BIN=$(pwd)/bin/athing-daemon turbo run dev",
    "gate:web-api": "bun scripts/gate-web-api.ts",
    "check-types": "bun run gate:web-api && turbo run check-types",
    "test": "turbo run test --filter='!./tests/*'",
    "eval": "turbo run eval",
    "e2e": "turbo run e2e",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "check-deps": "turbo run check-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "turbo": "^2.9.16",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14"
}
