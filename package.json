{
  "name": "a-thing",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test --filter='!./tests/*'",
    "test:integration": "turbo run test --filter=./tests/integration",
    "test:e2e": "turbo run test --filter=./tests/*",
    "lint": "oxlint packages apps tests",
    "format": "oxfmt --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "turbo": "^2.9.16",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14"
}