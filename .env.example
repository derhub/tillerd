# Server
PORT=3000

# Daemon paths (leave unset to use ~/.athing in production)
# In dev these are set automatically by `bun dev` via the root package.json script
ATHING_DIR=./.athing
ATHING_DAEMON_BIN=./bin/athing-daemon

# Override the agent binary path (optional; auto-resolved from PATH if unset)
# CLAUDE_CODE_EXECUTABLE=/path/to/claude

# Logging level for daemon (info, debug, warn, error, silent; default: info)
# LOG_LEVEL=info

# Hook notification client for desktop app (optional; auto-resolved from PATH if unset)
# ATHING_NOTIFY_BIN=./bin/athing-notify

# UI → API server origin (default: localhost:3000)
VITE_SERVER_ORIGIN=localhost:3000
