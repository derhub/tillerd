{
  "name": "@tillerd/daemon-pty",
  "version": "0.0.0",
  "bin": {
    "tillerd-daemon": "../../target/release/tillerd-daemon"
  },
  "type": "module",
  "scripts": {
    "dev": "cargo build --release && ../../target/release/tillerd-daemon",
    "build": "cargo build --release && { [ -z \"$TILLERD_DAEMON_BIN\" ] || { mkdir -p \"$(dirname \"$TILLERD_DAEMON_BIN\")\" && cp ../../target/release/tillerd-daemon \"$TILLERD_DAEMON_BIN\"; }; }",
    "lint": "cargo clippy --all-targets --locked -- -D warnings",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "test": "cargo test",
    "check-deps": "cargo outdated"
  }
}
