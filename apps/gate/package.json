{
  "name": "@tillerd/gate",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "tillerd-gate": "../../target/release/tillerd-gate"
  },
  "type": "module",
  "scripts": {
    "dev": "cargo build --release && ../../target/release/tillerd-gate",
    "build": "cargo build --release && { [ -z \"$TILLERD_GATE_BIN\" ] || { mkdir -p \"$(dirname \"$TILLERD_GATE_BIN\")\" && cp ../../target/release/tillerd-gate \"$TILLERD_GATE_BIN\"; }; }",
    "lint": "cargo clippy --all-targets --locked -- -D warnings",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "test": "cargo test",
    "check-deps": "cargo outdated"
  },
  "dependencies": {
    "@tillerd/contracts": "workspace:*",
    "@tillerd/paths": "workspace:*",
    "@tillerd/service-host": "workspace:*"
  }
}
