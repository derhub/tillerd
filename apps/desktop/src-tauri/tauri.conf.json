{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tillerd-desktop",
  "version": "0.0.0",
  "identifier": "com.tillerd.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "tillerd",
        "decorations": false,
        "hiddenTitle": true,
        "titleBarStyle": "Transparent",
        "width": 800,
        "height": 800,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
