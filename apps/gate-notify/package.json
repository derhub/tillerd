{
  "name": "@tillerd/gate-notify",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "tillerd-notify": "../../bin/tillerd-notify"
  },
  "type": "module",
  "scripts": {
    "dev": "cargo build --release",
    "build": "cargo build --release && mkdir -p \"$(dirname \"${TILLERD_NOTIFY_BIN:-../../bin/tillerd-notify}\")\" && cp ../../target/release/gate-notify \"${TILLERD_NOTIFY_BIN:-../../bin/tillerd-notify}\"",
    "lint": "cargo clippy --all-targets --locked -- -D warnings",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "test": "cargo test"
  },
  "dependencies": {
    "@tillerd/contracts": "workspace:*",
    "@tillerd/paths": "workspace:*"
  }
}
